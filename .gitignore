# -------------------------
# Root level universal ignores
# -------------------------

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor and IDE files (global)
.vscode/
.idea/
*.suo
*.user
*.userprefs
.claude/

# Logs and temp files
*.log
*.tmp
*.temp

# Archives
*.zip
*.tar
*.tar.gz
*.7z

# Secrets and environment files (if any at repo root)
.env
.env.local
.env.*.local
*.key
*.pem
